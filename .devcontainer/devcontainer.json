{
  "name": "BoxFerry",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {
      "version": "2.103.2"
    }
  },
  "containerEnv": {
    "CARGO_HOME": "/workspaces/.boxferry-cargo",
    "GH_CONFIG_DIR": "/workspaces/.boxferry-gh",
    "PATH": "/home/vscode/.local/bin:/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "mounts": [
    "source=boxferry-cargo-${devcontainerId},target=/workspaces/.boxferry-cargo,type=volume",
    "source=boxferry-gh-${devcontainerId},target=/workspaces/.boxferry-gh,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/verify-tools.sh",
  "waitFor": "postCreateCommand",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "DavidAnson.vscode-markdownlint",
        "esbenp.prettier-vscode",
        "exiasr.hadolint",
        "mkhl.shfmt",
        "ms-python.python",
        "redhat.vscode-yaml",
        "rust-lang.rust-analyzer",
        "streetsidesoftware.code-spell-checker",
        "timonwong.shellcheck",
        "tombi-toml.tombi",
        "vadimcn.vscode-lldb"
      ]
    }
  }
}
