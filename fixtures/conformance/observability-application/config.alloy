prometheus.scrape "boxferry_fixture" {
  targets = [
    {
      "__address__" = "metrics-producer:8080",
      "job"         = "boxferry_fixture",
    },
  ]
  metrics_path     = "/metrics"
  scrape_interval = "2s"
  forward_to       = [prometheus.remote_write.boxferry_fixture.receiver]
}

prometheus.remote_write "boxferry_fixture" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

local.file_match "boxferry_fixture" {
  path_targets = [
    {
      "__path__" = "/var/log/boxferry/*.log",
      "job"      = "boxferry_fixture",
    },
  ]
}

loki.source.file "boxferry_fixture" {
  targets    = local.file_match.boxferry_fixture.targets
  forward_to = [loki.write.boxferry_fixture.receiver]
}

loki.write "boxferry_fixture" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
