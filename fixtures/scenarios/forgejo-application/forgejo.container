[Container]
Image=codeberg.org/forgejo/forgejo@sha256:214f4ae63ee78be1e445e58573c88dc7215e72091210852e0df94eaac1a25685
User=1000
Group=1000
Environment=FORGEJO__database__DB_TYPE=postgres
Environment=FORGEJO__database__HOST=db:5432
Environment=FORGEJO__database__NAME=forgejo
Environment=FORGEJO__database__USER=forgejo
Environment=FORGEJO__database__PASSWD=boxferry-public-db-password-canary
Environment=FORGEJO__database__SSL_MODE=disable
Environment=FORGEJO__security__INSTALL_LOCK=true
Environment=FORGEJO__security__SECRET_KEY=boxferry-public-forgejo-secret-canary
Environment=FORGEJO__server__DOMAIN=127.0.0.1
Environment=FORGEJO__server__ROOT_URL=http://127.0.0.1:13000/
Environment=FORGEJO__server__SSH_DOMAIN=127.0.0.1
Environment=FORGEJO__server__SSH_PORT=12222
PublishPort=127.0.0.1:13000:3000
PublishPort=127.0.0.1:12222:2222
Volume=forgejo-data.volume:/var/lib/gitea
Network=backend.network
Network=edge
