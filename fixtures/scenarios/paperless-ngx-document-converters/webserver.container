[Unit]
Requires=broker.service db.service gotenberg.service tika.service
After=broker.service db.service gotenberg.service tika.service

[Container]
Image=ghcr.io/paperless-ngx/paperless-ngx@sha256:aa810a36942c63d4ee70d00eda7236cd3d6acfb7eb3f7987fb568ed14df8817a
Environment=PAPERLESS_REDIS=redis://broker:6379
Environment=PAPERLESS_DBHOST=db
Environment=PAPERLESS_DBNAME=paperless
Environment=PAPERLESS_DBUSER=paperless
Environment=PAPERLESS_DBPASS=boxferry-public-paperless-db-password-canary
Environment=PAPERLESS_SECRET_KEY=boxferry-public-paperless-secret-key-canary
Environment=USERMAP_UID=1000
Environment=USERMAP_GID=1000
Environment=PAPERLESS_TIME_ZONE=Europe/Berlin
Environment=PAPERLESS_OCR_LANGUAGE=eng
Environment=PAPERLESS_TASK_WORKERS=1
Environment=PAPERLESS_THREADS_PER_WORKER=1
Environment=PAPERLESS_WEBSERVER_WORKERS=1
Environment=PAPERLESS_TIKA_ENABLED=1
Environment=PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
Environment=PAPERLESS_TIKA_ENDPOINT=http://tika:9998
PublishPort=127.0.0.1:18000:8000/tcp
Volume=data.volume:/usr/src/paperless/data
Volume=media.volume:/usr/src/paperless/media
Volume=consume.volume:/usr/src/paperless/consume
Volume=export.volume:/usr/src/paperless/export
Network=backend.network
