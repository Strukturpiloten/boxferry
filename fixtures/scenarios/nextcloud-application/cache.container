[Container]
Image=docker.io/library/redis@sha256:987c376c727652f99625c7d205a1cba3cb2c53b92b0b62aade2bd48ee1593232
Environment=BOXFERRY_REDIS_TEST_PASSWORD=boxferry-test-cache-password-not-secret
Volume=redis-data.volume:/data
Network=backend.network
HealthCmd=["CMD","redis-cli","ping"]
HealthInterval=10s
HealthTimeout=3s
HealthRetries=12

[Service]
Restart=always
