[Container]
Image=docker.io/grafana/alloy@sha256:b8ec653c44235fbe910879145dac3597d66b0aaecf60bcbbe82580767771a839
Exec=run --storage.path=/var/lib/alloy/data /etc/alloy/config.alloy
Volume=alloy-data.volume:/var/lib/alloy/data
Volume=telemetry-logs.volume:/var/log/boxferry:ro
Network=backend.network
