{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**"
  ],
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "timezone": "Europe/Berlin",
  "dockerfile": {
    "enabled": false
  },
  "docker-compose": {
    "enabled": false
  },
  "quadlet": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versioned Dev Container tools",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nARG [A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update directly pinned workflow tool versions",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+version: \"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+node-version: (?<currentValue>[^\\s]+)",
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n\\s+run: cargo install --locked --version (?<currentValue>[^\\s]+) [^\\s]+"
      ]
    },
    {
      "customType": "regex",
      "description": "Track fixed GitHub-hosted runner environments",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "(?:^|\\n)\\s*runs-on:\\s*(?<depName>ubuntu|macos|windows)-(?<currentValue>[0-9]+(?:\\.[0-9]+)?(?:-[a-z0-9]+)*)\\s*(?:\\n|$)"
      ],
      "datasourceTemplate": "github-runners"
    },
    {
      "customType": "regex",
      "description": "Track the immutable Strukturpiloten shared-policy commit",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "(?<indentation>[ \\t]*)# renovate: datasource=github-digest depName=(?<depName>Strukturpiloten/\\.github) currentValue=(?<currentValue>main)\\n[ \\t]*ref:\\s*(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-digest",
      "autoReplaceStringTemplate": "{{{indentation}}}# renovate: datasource=github-digest depName={{{depName}}} currentValue={{{newValue}}}\n{{{indentation}}}ref: {{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Track the immutable DockerLens application admission commit",
      "managerFilePatterns": [
        "/^\\.github/workflows/reviewed-(?:application|docker-consumer)-validation\\.yml$/"
      ],
      "matchStrings": [
        "(?<indentation>[ \\t]*)# renovate: datasource=github-digest depName=(?<depName>Strukturpiloten/docker-lens) currentValue=(?<currentValue>main)\\n[ \\t]*ADMISSION_REVISION:\\s*(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-digest",
      "autoReplaceStringTemplate": "{{{indentation}}}# renovate: datasource=github-digest depName={{{depName}}} currentValue={{{newValue}}}\n{{{indentation}}}ADMISSION_REVISION: {{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Track the immutable DockerLens custody helper commit",
      "managerFilePatterns": ["/^\\.github/workflows/reviewed-docker-consumer-validation\\.yml$/"],
      "matchStrings": [
        "(?<indentation>[ \\t]*)# renovate: datasource=github-digest depName=(?<depName>Strukturpiloten/docker-lens) currentValue=(?<currentValue>TheRealBecks/issue172)\\n[ \\t]*CUSTODY_HELPER_REVISION:\\s*(?<currentDigest>[a-f0-9]{40})"
      ],
      "datasourceTemplate": "github-digest",
      "autoReplaceStringTemplate": "{{{indentation}}}# renovate: datasource=github-digest depName={{{depName}}} currentValue={{{newValue}}}\n{{{indentation}}}CUSTODY_HELPER_REVISION: {{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Update the Dev Container base release and digest together",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n# release: (?<currentValue>[^\\s]+)\\nFROM [^\\s]+@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}\n# release: {{{newValue}}}\nFROM {{{depName}}}:{{{newValue}}}@{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Update the documented Dev Container CLI",
      "managerFilePatterns": ["/^docs/development-environment\\.md$/"],
      "matchStrings": ["@devcontainers/cli@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "@devcontainers/cli"
    },
    {
      "customType": "regex",
      "description": "Update the GitHub CLI installed in the Dev Container",
      "managerFilePatterns": ["/^\\.devcontainer/devcontainer\\.json$/"],
      "matchStrings": [
        "\"ghcr\\.io/devcontainers/features/github-cli:[^\"]+\"[\\s\\S]*?\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cli/cli"
    },
    {
      "customType": "regex",
      "description": "Update the Docker Compose provider release and its matching binary checksum",
      "managerFilePatterns": ["/^scripts/lib/compose-provider\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>docker/compose)\\n  local -r expected_release=\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\"\\n  local -r expected_sha256=\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "depNameTemplate": "docker/compose",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "description": "Update active Compose provider catalogue rows with the canonical release and checksum",
      "managerFilePatterns": [
        "/^fixtures/conformance/(?:forgejo|immich|nextcloud|observability|paperless-ngx)-application/providers\\.tsv$/"
      ],
      "matchStrings": [
        "docker-compose\\t[0-9]+\\.[0-9]+\\.[0-9]+\\thttps://github\\.com/docker/compose/releases/download/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)/docker-compose-linux-x86_64\\t(?<currentDigest>[a-f0-9]{64})"
      ],
      "autoReplaceStringTemplate": "docker-compose\t{{{replace \"^v\" \"\" newValue}}}\thttps://github.com/docker/compose/releases/download/{{{newValue}}}/docker-compose-linux-x86_64\t{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "depNameTemplate": "docker/compose",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "description": "Update the active Supabase Compose provider catalogue release and checksum",
      "managerFilePatterns": ["/^fixtures/conformance/supabase-application/providers\\.tsv$/"],
      "matchStrings": [
        "docker-compose\\t[0-9]+\\.[0-9]+\\.[0-9]+\\tlinux-amd64\\t(?<currentDigest>[a-f0-9]{64})\\thttps://github\\.com/docker/compose/releases/download/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)/docker-compose-linux-x86_64"
      ],
      "autoReplaceStringTemplate": "docker-compose\t{{{replace \"^v\" \"\" newValue}}}\tlinux-amd64\t{{{newDigest}}}\thttps://github.com/docker/compose/releases/download/{{{newValue}}}/docker-compose-linux-x86_64"
    },
    {
      "customType": "regex",
      "description": "Track reviewed live-application container images",
      "managerFilePatterns": [
        "/^fixtures/conformance/(?:forgejo|immich|nextcloud|observability|paperless-ngx|supabase)-application/images\\.tsv$/"
      ],
      "matchStrings": [
        "(?:^|\\n)[^#\\s]+[ \\t]+(?<depName>[^\\s:@]+(?:/[^\\s:@]+)+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})(?:[ \\t]|$)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track release-bound native Lens conformance revisions",
      "managerFilePatterns": ["/^fixtures/conformance/migration-readiness/tiers\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=github-tags depName=(?<depName>[^\\s]+) version=(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\nrevision = \"(?<currentDigest>[a-f0-9]{40})\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Track reviewed live Podman matrix images",
      "managerFilePatterns": ["/^fixtures/conformance/podman-live/matrix\\.tsv$/"],
      "matchStrings": [
        "(?:^|\\n)[^#\\s]+[ \\t]+(?<depName>[^\\s:@]+(?:/[^\\s:@]+)+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})(?:[ \\t]|$)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the digest-pinned live workload probe image",
      "managerFilePatterns": ["/^scripts/podman-live-conformance\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\nworkload_image=\"[^@\"]+@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    },
    {
      "customType": "regex",
      "description": "Signal updates for checksum-pinned Kubernetes development tools",
      "managerFilePatterns": ["/^scripts/install-kubernetes-tools\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>kubernetes/kubernetes|helm/helm)\\nreadonly [a-z0-9_]+_version=\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Update kind's exact release tag and per-architecture asset digest together",
      "managerFilePatterns": ["/^scripts/install-kubernetes-tools\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=github-release-attachments depName=(?<depName>kubernetes-sigs/kind) depType=(?<depType>kind-linux-(?<architecture>amd64))\\nreadonly kind_amd64_release=\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\" kind_amd64_checksum=\"(?<currentDigest>[a-f0-9]{64})\"",
        "# renovate: datasource=github-release-attachments depName=(?<depName>kubernetes-sigs/kind) depType=(?<depType>kind-linux-(?<architecture>arm64))\\nreadonly kind_arm64_release=\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\" kind_arm64_checksum=\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "Track Kustomize releases separately from kyaml and API releases",
      "managerFilePatterns": ["/^scripts/install-kubernetes-tools\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>kubernetes-sigs/kustomize)\\nreadonly [a-z0-9_]+_version=\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^kustomize/v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update the reviewed direct release-emulator image and digest together",
      "managerFilePatterns": ["/^scripts/lib/release-emulator\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+)\\nreadonly release_emulator_image='[^']+:(?<currentValue>qemu-v[^@']+)@(?<currentDigest>sha256:[a-f0-9]{64})'"
      ],
      "versioningTemplate": "regex:^qemu-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$",
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}\nreadonly release_emulator_image='{{{depName}}}:{{{newValue}}}@{{{newDigest}}}'"
    },
    {
      "customType": "regex",
      "description": "Update each canonical uv release-attachment checksum and its release annotation; the pyproject regex owns the execution version.",
      "managerFilePatterns": ["/^automation/uv-artifacts\\.json$/"],
      "matchStrings": [
        "\"filename\"[ \\t]*:[ \\t]*\"(?<depType>uv-(?:x86_64|aarch64)-unknown-linux-gnu\\.tar\\.gz)\"\\s*,\\s*\"currentVersion\"[ \\t]*:[ \\t]*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*,\\s*\"sha256\"[ \\t]*:[ \\t]*\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "depNameTemplate": "astral-sh/uv",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "Own the uv execution constraint, which pep621 consumes but does not extract as a versioned dependency.",
      "managerFilePatterns": ["/^(?:automation/)?pyproject\\.toml$/"],
      "matchStrings": [
        "\\[tool\\.uv\\][^\\[]*?required-version[ \\t]*=[ \\t]*\"==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "description": "Update the immutable native Renovate test runtime version and OCI digest atomically.",
      "managerFilePatterns": ["/^automation/renovate-runtime\\.json$/"],
      "matchStrings": [
        "\"image\"[ \\t]*:[ \\t]*\"(?<depName>ghcr\\.io/renovatebot/renovate):(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update each canonical downloaded-tool release tag and architecture checksum atomically; asset filenames are computed from version-independent templates.",
      "managerFilePatterns": ["/^automation/tool-artifacts\\.json$/"],
      "matchStrings": [
        "\"repository\"\\s*:\\s*\"(?<depName>tombi-toml/tombi|mvdan/sh|koalaman/shellcheck|hadolint/hadolint|rhysd/actionlint|lycheeverse/lychee)\"\\s*,\\s*\"architecture\"\\s*:\\s*\"(?<depType>x86_64|aarch64)\"\\s*,\\s*\"filenameTemplate\"\\s*:\\s*\"[^\"\\r\\n]+\"\\s*,\\s*\"memberTemplate\"\\s*:\\s*(?:null|\"[^\"\\r\\n]+\")\\s*,\\s*\"archive\"\\s*:\\s*\"(?:binary|tar\\.gz|tar\\.xz)\"\\s*,\\s*\"currentVersion\"\\s*:\\s*\"(?<currentValue>(?:v|lychee-v)[0-9]+\\.[0-9]+\\.[0-9]+)\"\\s*,\\s*\"sha256\"\\s*:\\s*\"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "regex:^(?:v|lychee-v)(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "depNameTemplate": "Strukturpiloten/boxferry",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "automation-v1",
      "description": "Update the consumer adoption manifest at the same immutable shared revision.",
      "managerFilePatterns": ["/^\\.github/automation\\.json$/"],
      "matchStrings": [
        "(?<prefix>\"revision\"[ \\t]*:[ \\t]*\")(?<currentDigest>[a-f0-9]{40})(?<suffix>\")"
      ]
    },
    {
      "customType": "regex",
      "depNameTemplate": "Strukturpiloten/boxferry",
      "datasourceTemplate": "github-digest",
      "currentValueTemplate": "automation-v1",
      "description": "Update explicit shared workflow revision inputs and environment pins.",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "(?<prefix>(?:^|\\n)[ \\t]*(?:automation_sha|automation-sha|AUTOMATION_SHA):[ \\t]*[\"\\']?)(?<currentDigest>[a-f0-9]{40})(?<suffix>[\"\\']?)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep non-major Dev Container image updates together",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".devcontainer/Dockerfile"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "Dev Container toolchain"
    },
    {
      "description": "Group compatible Rust dependency updates",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "Rust dependencies"
    },
    {
      "description": "Keep ZIP on advisory-fixed releases after the reviewed Rust baseline increase",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["zip"],
      "allowedVersions": ">=9.0.3"
    },
    {
      "description": "Group repository Node development-tool updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "Node development tools"
    },
    {
      "description": "Pin every GitHub Action to an immutable commit hash",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "pinDigests": true
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Automerge tested non-major dependency updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Automerge green-gated lock-file maintenance",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": "0 days",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false
    },
    {
      "description": "Review GitHub-hosted runner environment upgrades manually",
      "matchDatasources": ["github-runners"],
      "groupName": "GitHub-hosted runners",
      "automerge": false,
      "prBodyNotes": [
        "Review the hosted image release notes and verify every workflow's operating-system environment before merging."
      ]
    },
    {
      "description": "Require explicit security review for the DockerLens application admission pin",
      "matchDatasources": ["github-digest"],
      "matchPackageNames": ["Strukturpiloten/docker-lens"],
      "matchFileNames": [
        ".github/workflows/reviewed-application-validation.yml",
        ".github/workflows/reviewed-docker-consumer-validation.yml"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Review the shared admission helper, both actors' permission checks, exact-head enforcement, and BoxFerry application evidence before accepting this infrastructure change.",
        "For the temporary issue172 custody-helper ref, manually review the immutable source, lockfile and eight helper hashes together. The tracked ref must move to reviewed main or release before that infrastructure branch is deleted; digest updates alone never authorize root execution."
      ]
    },
    {
      "description": "Do not delay BoxFerry and Lens releases",
      "matchManagers": ["cargo"],
      "matchDatasources": ["crate"],
      "matchPackageNames": [
        "boxferry",
        "boxferry-model",
        "boxferry-engine",
        "boxferry-compose",
        "boxferry-podman",
        "boxferry-quadlet",
        "compose-lens",
        "podman-lens",
        "quadlet-lens",
        "docker-lens"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Keep Dev Container feature versions current; the lock file owns digests",
      "matchManagers": ["devcontainer"],
      "matchDepTypes": ["feature"],
      "pinDigests": false,
      "groupName": "Dev Container",
      "automerge": false,
      "prBodyNotes": [
        "Regenerate and commit the Dev Container feature lock as documented in docs/development-environment.md."
      ]
    },
    {
      "description": "Require manual review of Dev Container image and tool updates",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".devcontainer/Dockerfile"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "prBodyNotes": [
        "Review all shared workspace consumers, exact versions and image digests, then rebuild and validate the Dev Container before merging."
      ]
    },
    {
      "description": "Require native revalidation of Lens conformance revisions",
      "matchFileNames": ["fixtures/conformance/migration-readiness/tiers.toml"],
      "matchDatasources": ["github-tags"],
      "pinDigests": true,
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "Native Lens conformance",
      "prBodyNotes": [
        "Review the exact release commit and native evidence; update processing or generator target metadata and rerun downstream conformance. Discovery alone does not admit support."
      ]
    },
    {
      "description": "Require explicit revalidation for live application and workload images",
      "matchDatasources": ["docker"],
      "matchFileNames": [
        "fixtures/conformance/*-application/images.tsv",
        "fixtures/conformance/podman-live/matrix.tsv",
        "scripts/podman-live-conformance.sh"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "Live acceptance images",
      "prBodyNotes": [
        "Review image provenance, license, platform digest, resource budget, and live behavior before merging."
      ]
    },
    {
      "description": "Provisionally hold Docker Compose provider proposals pending native qualification",
      "enabled": false,
      "prBodyNotes": ["Verify the exact provider release, checksum and downstream compatibility."],
      "pinDigests": true,
      "matchDatasources": ["github-release-attachments"],
      "matchPackageNames": ["docker/compose"],
      "groupName": "Docker Compose provider",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Keep Rust toolchain updates visible and separate",
      "matchManagers": ["rust-toolchain"],
      "groupName": "Rust toolchain"
    },
    {
      "description": "Group Kubernetes development tool versions and integrity refreshes",
      "matchFileNames": ["scripts/install-kubernetes-tools.sh"],
      "groupName": "Kubernetes development tools",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "dependencyDashboardApproval": false,
      "matchPackageNames": [
        "kubernetes-sigs/kind",
        "kubernetes/kubernetes",
        "helm/helm",
        "kubernetes-sigs/kustomize"
      ]
    },
    {
      "description": "Require review of release-emulator version and digest changes",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/tonistiigi/binfmt"],
      "groupName": "release emulator image",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Bootstrap shared Python package/build tools and their lockfile before immutable preset adoption.",
      "matchManagers": ["pep621"],
      "groupName": "Python automation",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Bootstrap the exact Python interpreter owner before immutable preset adoption.",
      "matchManagers": ["pyenv"],
      "groupName": "Python interpreter",
      "automerge": true,
